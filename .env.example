DATABASE_URL=file:./dev.db

# Aïmane admin auth — choose a strong password in production.
ADMIN_PASSWORD=change-me
# A long random string used to sign the admin session cookie.
SESSION_SECRET=generate-a-long-random-string-here

# GitHub image upload (optional). When set, uploaded product images are
# committed to the aimane-media repo via the GitHub Contents API. When unset,
# images are saved to /public/uploads as a local fallback so the app keeps working.
GITHUB_TOKEN=
GITHUB_OWNER=odin10032-rgb
GITHUB_REPO=aimane-media
GITHUB_BRANCH=main
GITHUB_PATH=products
